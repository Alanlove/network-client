<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WindowsClient.Views.RulesPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="分流规则" FontSize="22"/>

        <Border Grid.Row="1" Style="{ThemeResource CardBorderFilledStyle}" Padding="16">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Header="类型"
                              ItemsSource="{x:Bind Vm.Kinds}"
                              SelectedItem="{x:Bind Vm.SelectedKind, Mode=TwoWay}"/>
                    <ComboBox Grid.Column="1" Header="动作"
                              ItemsSource="{x:Bind Vm.Actions}"
                              SelectedItem="{x:Bind Vm.SelectedAction, Mode=TwoWay}"/>
                    <TextBox Grid.Column="2" Header="值（如 example.com / 10.0.0.0/8 / CN）"
                             Text="{x:Bind Vm.NewValue, Mode=TwoWay}"/>
                    <Button Grid.Column="3" VerticalAlignment="Bottom" Width="80"
                            Style="{ThemeResource AccentButtonStyle}"
                            Content="添加" Command="{x:Bind Vm.AddCommand}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="模式：" VerticalAlignment="Center"/>
                    <Button Content="智能" Click="Mode_Click" Tag="smart"
                            Style="{ThemeResource SubtleButtonStyle}"/>
                    <Button Content="全局" Click="Mode_Click" Tag="global"
                            Style="{ThemeResource SubtleButtonStyle}"/>
                    <Button Content="直连" Click="Mode_Click" Tag="direct"
                            Style="{ThemeResource SubtleButtonStyle}"/>
                    <TextBlock Text="{x:Bind Vm.Mode, Mode=OneWay}" VerticalAlignment="Center"
                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                </StackPanel>
                <TextBlock Text="{x:Bind Vm.Message, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{ThemeResource CardBorderFilledStyle}" Padding="16">
            <StackPanel Spacing="10">
                <TextBlock Text="规则测试" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Header="输入域名或 IP（如 google.com / 8.8.8.8）"
                             Text="{x:Bind Vm.TestInput, Mode=TwoWay}"/>
                    <Button Grid.Column="1" VerticalAlignment="Bottom"
                            Style="{ThemeResource AccentButtonStyle}"
                            Content="测试" Command="{x:Bind Vm.TestRuleCommand}"/>
                </Grid>
                <TextBlock Text="{x:Bind Vm.TestResult, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ListView Grid.Row="3" ItemsSource="{x:Bind Vm.Rules}" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="mdl:Rule" xmlns:mdl="using:WindowsClient.Models">
                    <Grid Padding="14,10" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Kind}" FontFamily="Consolas"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind Action}"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind Priority}"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <Button Grid.Column="4" Content="删除"
                                Command="{Binding Vm.DeleteCommand, ElementName=PageRoot}"
                                CommandParameter="{x:Bind}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
