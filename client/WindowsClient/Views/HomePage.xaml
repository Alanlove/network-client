<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WindowsClient.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Padding="28" Spacing="18" MaxWidth="720" HorizontalAlignment="Stretch">

            <!-- ========== 连接状态主卡片 ========== -->
            <Border Style="{ThemeResource CardBorderFilledStyle}" Padding="24,20">
                <Grid>
                    <StackPanel Spacing="14">
                        <!-- 状态行 -->
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Ellipse Width="12" Height="12" Margin="2,6,0,0"
                                         Fill="{x:Bind Vm.IsConnected, Mode=OneWay, Converter={StaticResource BoolToConnBrush}}"/>
                                <TextBlock Text="{x:Bind Vm.StateText, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"/>
                                <ProgressRing IsActive="{x:Bind Vm.Busy, Mode=OneWay}"
                                              Width="20" Height="20" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind Vm.StatusMessage, Mode=OneWay}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       TextWrapping="Wrap" Margin="14,4,0,0"/>
                        </Grid>

                        <!-- 节点信息 -->
                        <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE77B;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind Vm.NodeName, Mode=OneWay}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind Vm.LatencyText, Mode=OneWay}"
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                        </StackPanel>

                        <!-- 速率 + 今日流量 -->
                        <Grid ColumnSpacing="24" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Padding="16,12"
                                    Background="{ThemeResource ControlOnImageFillBrush}">
                                <StackPanel>
                                    <TextBlock Text="实时速率" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="12"/>
                                    <TextBlock Text="{x:Bind Vm.DownRateText, Mode=OneWay}"
                                               FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind Vm.UpRateText, Mode=OneWay}"
                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Padding="16,12"
                                    Background="{ThemeResource ControlOnImageFillBrush}">
                                <StackPanel>
                                    <TextBlock Text="今日流量" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="12"/>
                                    <TextBlock Text="{x:Bind Vm.TodayText, Mode=OneWay}"
                                               FontSize="20" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========== 实时速率图表 ========== -->
            <Border Style="{ThemeResource CardBorderFilledStyle}" Padding="16">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="速率曲线 (最近 2 分钟)" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Width="12" Height="3" Fill="#2196F3" RadiusX="1" RadiusY="1"/>
                                <TextBlock Text="{x:Bind Vm.DownRateText, Mode=OneWay}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Width="12" Height="3" Fill="#4CAF50" RadiusX="1" RadiusY="1"/>
                                <TextBlock Text="{x:Bind Vm.UpRateText, Mode=OneWay}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Canvas x:Name="RateChart" Grid.Row="1" Height="100" HorizontalAlignment="Stretch"/>
                </Grid>
            </Border>

            <!-- ========== 连接设置 ========== -->
            <Border Style="{ThemeResource CardBorderFilledStyle}" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="连接设置" Style="{ThemeResource BodyStrongTextBlockStyle}"/>

                    <ComboBox Header="节点" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind Vm.Nodes}"
                              SelectedItem="{x:Bind Vm.SelectedNode, Mode=TwoWay}"
                              DisplayMemberPath="Display"/>

                    <RadioButtons x:Name="ModeSelector" Header="分流模式"
                                  SelectedIndex="1" MaxColumns="3"
                                  SelectionChanged="ModeSelector_SelectionChanged">
                        <RadioButton Content="全局" Tag="global"/>
                        <RadioButton Content="智能" Tag="smart"/>
                        <RadioButton Content="直连" Tag="direct"/>
                    </RadioButtons>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" HorizontalAlignment="Stretch"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind Vm.ConnectCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE930;"/>
                                <TextBlock Text="连接"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Width="140"
                                Command="{x:Bind Vm.DisconnectCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE774;"/>
                                <TextBlock Text="断开"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
