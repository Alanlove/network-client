<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WindowsClient</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- MSIX packaging disabled (we use Inno Setup / zip instead)
         BUT EnableMsixTooling MUST be true — it produces both .xbf (XAML binary)
         and .pri (Package Resource Index). Without these:
           - No .xbf → InitializeComponent() fails (0x802B000A XamlParseException)
           - No .pri  → Navigate(typeof(Page)) fails (ms-appx:/// resource not found)
         WindowsPackageType=None means: MSIX toolchain runs, but no .msix/.appx is produced. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <EnableCoreMrtTooling>true</EnableCoreMrtTooling>
    <AppxGeneratePriEnabled>true</AppxGeneratePriEnabled>
    <WindowsPackageType>None</WindowsPackageType>
    <AppxPackage>false</AppxPackage>
    <GeneratePriFile>true</GeneratePriFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <LangVersion>latest</LangVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

</Project>
